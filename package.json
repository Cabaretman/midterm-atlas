{
  "name": "midterm-atlas",
  "version": "1.0.0",
  "description": "Interactive 2026 Senate, House and governor scenario laboratory",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/model.test.mjs",
    "test:browser": "playwright test",
    "profile": "node scripts/profile-browser.mjs",
    "prepare:polling": "python scripts/build-polling.py && python scripts/prepare-data.py",
    "fit:fundamentals": "python scripts/fit-fundamentals.py && python scripts/prepare-data.py",
    "prepare:data": "python scripts/prepare-data.py && node scripts/prepare-map.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "us-atlas": "^3.0.1"
  }
}
